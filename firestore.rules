rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function adminConfigExists() {
      return exists(/databases/$(database)/documents/app-config/admin);
    }

    function adminEmails() {
      return adminConfigExists()
        && get(/databases/$(database)/documents/app-config/admin).data.keys().hasAny(['enabledEmails'])
        && get(/databases/$(database)/documents/app-config/admin).data.enabledEmails is list
        ? get(/databases/$(database)/documents/app-config/admin).data.enabledEmails
        : [];
    }

    function isAdminEmail() {
      return signedIn()
        && authEmail() != ''
        && adminConfigExists()
        && authEmail() in adminEmails();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function canReadPublicProfile(uid) {
      return isSelf(uid) || (resource.data.isPublic == true);
    }

    match /users/{uid} {
      allow read: if canReadPublicProfile(uid) || isAdminEmail();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid)
        && !('moderationProfileClearedAt' in request.resource.data)
        && !('socialIsolation' in request.resource.data)
        && !('publishBlocked' in request.resource.data)
        || isAdminEmail();
      allow delete: if isSelf(uid) || isAdminEmail();

      match /private/agreement {
        allow read: if isSelf(uid) || isAdminEmail();
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['acceptedAt', 'version'])
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.version == '2026-10-10';
        allow update, delete: if false;
      }
    }

    match /published-recipes/{recipeId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid || isAdminEmail()
      );
      allow delete: if signedIn() && (
        resource.data.authorId == request.auth.uid || isAdminEmail()
      );
    }

    match /family-books/{familyId} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || request.auth.uid in resource.data.removedMemberIds
        || isAdminEmail()
      );
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.creatorId == request.auth.uid
        || request.auth.uid in resource.data.memberIds
        || isAdminEmail()
      );
      allow delete: if signedIn() && (
        resource.data.creatorId == request.auth.uid || isAdminEmail()
      );
    }

    function shoppingAuthEmail() {
      return authEmail() != '' ? authEmail().lower() : '';
    }

    // Hard-coded access superuser (exact email + verified). No admins doc involved.
    function isAccessSuperuser() {
      return signedIn()
        && request.auth.token.email == 'm.holtzapffel@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return authEmail() != '' ? authEmail().lower() : '';
    }

    function canReadOwnAccessGrant(emailLower) {
      return signedIn()
        && request.auth.token.email_verified == true
        && authEmailLower() != ''
        && authEmailLower() == emailLower;
    }

    function shoppingListHasMemberIds() {
      return resource.data.keys().hasAny(['memberIds'])
        && resource.data.memberIds is list;
    }

    function shoppingListHasPendingEmails() {
      return resource.data.keys().hasAny(['pendingInviteEmails'])
        && resource.data.pendingInviteEmails is list;
    }

    function isShoppingListOwner() {
      return signedIn()
        && resource.data.keys().hasAny(['ownerId'])
        && resource.data.ownerId == request.auth.uid;
    }

    function isShoppingListMember() {
      return signedIn()
        && shoppingListHasMemberIds()
        && request.auth.uid in resource.data.memberIds;
    }

    function isShoppingListPendingInvitee() {
      return signedIn()
        && shoppingAuthEmail() != ''
        && shoppingListHasPendingEmails()
        && shoppingAuthEmail() in resource.data.pendingInviteEmails;
    }

    function shoppingOwnerIdUnchanged() {
      return request.resource.data.keys().hasAny(['ownerId'])
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    function shoppingMembershipLocked() {
      return request.resource.data.keys().hasAll(['ownerId', 'ownerEmail', 'memberIds', 'memberEmails', 'pendingInviteEmails'])
        && shoppingOwnerIdUnchanged()
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.memberEmails == resource.data.memberEmails
        && request.resource.data.pendingInviteEmails == resource.data.pendingInviteEmails
        && (
          !resource.data.keys().hasAny(['members'])
          || request.resource.data.members == resource.data.members
        );
    }

    function shoppingAcceptingInvite() {
      return isShoppingListPendingInvitee()
        && shoppingOwnerIdUnchanged()
        && request.resource.data.keys().hasAll(['ownerEmail', 'memberIds', 'memberEmails', 'pendingInviteEmails'])
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.memberIds is list
        && request.resource.data.memberEmails is list
        && request.resource.data.pendingInviteEmails is list
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && shoppingAuthEmail() in request.resource.data.memberEmails
        && !(shoppingAuthEmail() in request.resource.data.pendingInviteEmails)
        && request.resource.data.pendingInviteEmails.size() < resource.data.pendingInviteEmails.size()
        && request.resource.data.items == resource.data.items
        && request.resource.data.collaborators == resource.data.collaborators;
    }

    function shoppingMemberContentOnlyUpdate() {
      return isShoppingListMember()
        && shoppingMembershipLocked();
    }

    function shoppingOwnerCreateValid(listId) {
      return signedIn()
        && listId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId', 'ownerEmail', 'memberIds', 'memberEmails', 'pendingInviteEmails', 'items', 'collaborators', 'updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerEmail == shoppingAuthEmail()
        && shoppingAuthEmail() != ''
        && request.resource.data.memberIds is list
        && request.resource.data.memberEmails is list
        && request.resource.data.pendingInviteEmails is list
        && request.auth.uid in request.resource.data.memberIds
        && shoppingAuthEmail() in request.resource.data.memberEmails
        && request.resource.data.items is list
        && request.resource.data.collaborators is list;
    }

    match /shopping-lists/{listId} {
      // Single-doc reads for owner, members, and pending invitees.
      // Pending invite discovery uses /shopping-list-invites (list queries here are denied).
      // Allow get on missing owned docs so clients can seed shopping-lists/{uid}.
      allow get: if signedIn() && (
        listId == request.auth.uid
        || (
          resource != null
          && (
            resource.data.ownerId == request.auth.uid
            || (resource.data.memberIds is list && request.auth.uid in resource.data.memberIds)
            || (resource.data.pendingInviteEmails is list && shoppingAuthEmail() in resource.data.pendingInviteEmails)
          )
        )
      );
      allow list: if false;

      // One owned list doc per uid; owner seeds membership + empty pending invites.
      allow create: if shoppingOwnerCreateValid(listId);

      // Owner manages invites/members/content (ownerId stays fixed).
      // Members may update items/collaborators only.
      // Pending invitees may accept once (self +1 to memberIds, email leaves pending).
      allow update: if signedIn() && (
        (isShoppingListOwner() && shoppingOwnerIdUnchanged())
        || shoppingMemberContentOnlyUpdate()
        || shoppingAcceptingInvite()
      );

      allow delete: if isShoppingListOwner();
    }

    // Email invite mailbox: invitees query their own invites without listing shopping-lists.
    match /shopping-list-invites/{inviteId} {
      allow get: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (shoppingAuthEmail() != '' && resource.data.inviteeEmail == shoppingAuthEmail())
      );

      // Invitee inbox query: where('inviteeEmail', '==', authEmail)
      allow list: if signedIn()
        && shoppingAuthEmail() != ''
        && resource.data.inviteeEmail == shoppingAuthEmail();

      allow create: if signedIn()
        && shoppingAuthEmail() != ''
        && request.resource.data.keys().hasAll(['listId', 'ownerId', 'ownerEmail', 'inviteeEmail', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.listId == request.auth.uid
        && request.resource.data.ownerEmail == shoppingAuthEmail()
        && request.resource.data.inviteeEmail is string
        && request.resource.data.inviteeEmail == request.resource.data.inviteeEmail.lower()
        && request.resource.data.inviteeEmail != shoppingAuthEmail();

      allow delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (shoppingAuthEmail() != '' && resource.data.inviteeEmail == shoppingAuthEmail())
      );

      allow update: if false;
    }

    // Full-access grants keyed by lowercase email. Users may only read their own doc.
    // Only the hard-coded superuser may list, create, or delete. Nobody may update grants.
    match /access/{emailLower} {
      allow get: if canReadOwnAccessGrant(emailLower) || isAccessSuperuser();
      allow list: if isAccessSuperuser();
      allow create, delete: if isAccessSuperuser();
      allow update: if false;
    }

    match /app-config/{docId} {
      allow read: if signedIn();
      // Admin doc is managed manually (console/admin SDK) or by existing admins only.
      allow create: if isAdminEmail();
      allow update, delete: if isAdminEmail();
    }

    match /user-moderation/{uid} {
      allow read: if isSelf(uid) || isAdminEmail();
      allow create, update, delete: if isAdminEmail();
    }

    match /moderation-reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if isAdminEmail() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdminEmail();
    }

    match /moderation-log/{entryId} {
      allow create: if isAdminEmail();
      allow read: if isAdminEmail();
      allow update, delete: if false;
    }

    // ===== BEGIN familiecode (accessCodes + codeAccess) =====
    // accessCodes/{CODE}: document id is the code itself (trimmed, uppercase,
    // [A-Z0-9_-], 1-32). Created and edited only by the access superuser
    // (isAccessSuperuser, e.g. from /beheer). Real codes are never in the repo.
    //   type: "familyPremium"   expiresAt: timestamp   active: bool
    //   used: int (>= 0)        maxUses: int (1-15)
    //   lastRevokedUid: string (optional, only set in a revoke batch)
    // Clients can never get or list codes; only the superuser can.
    //
    // codeAccess/{uid}: fields exactly code, type, createdAt (+ revoked,
    // revokedAt set by the superuser). Created only by the signed-in owner, in
    // one batch with accessCodes/{code}.used + 1. The owner may read it.
    // No client update or delete. Revocation keeps the document, so the same
    // account cannot redeem again, and lowers used by exactly 1 in the same
    // batch (superuser only), so the place becomes free again.

    function famCodePath(code) {
      return /databases/$(database)/documents/accessCodes/$(code);
    }

    function famGrantPath(grantUid) {
      return /databases/$(database)/documents/codeAccess/$(grantUid);
    }

    function famIsCodeId(code) {
      return code is string && code.matches('[A-Z0-9_-]{1,32}');
    }

    function famIsValidCodeDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly(['type', 'expiresAt', 'active', 'used', 'maxUses', 'lastRevokedUid'])
        && data.keys().hasAll(['type', 'expiresAt', 'active', 'used', 'maxUses'])
        && data.type in ['familyPremium']
        && data.expiresAt is timestamp
        && data.active is bool
        && data.used is int
        && data.used >= 0
        && data.maxUses is int
        && data.maxUses >= 1
        && data.maxUses <= 15
        && data.used <= data.maxUses;
    }

    // Superuser edits a code (end date, active, maxUses, type) but never
    // touches used or lastRevokedUid outside a revoke batch.
    function famIsSuperuserEdit() {
      return isAccessSuperuser()
        && famIsValidCodeDoc()
        && request.resource.data.used == resource.data.used
        && request.resource.data.get('lastRevokedUid', null) == resource.data.get('lastRevokedUid', null);
    }

    // Superuser revoke step: used - 1 (never below 0), lastRevokedUid names the
    // person, whose codeAccess for this code was not revoked before this batch
    // and is revoked after it.
    function famIsRevokeStep(code) {
      let next = request.resource.data;
      return isAccessSuperuser()
        && next.diff(resource.data).affectedKeys().hasOnly(['used', 'lastRevokedUid'])
        && next.used == resource.data.used - 1
        && next.used >= 0
        && next.lastRevokedUid is string
        && exists(famGrantPath(next.lastRevokedUid))
        && get(famGrantPath(next.lastRevokedUid)).data.code == code
        && get(famGrantPath(next.lastRevokedUid)).data.get('revoked', false) != true
        && getAfter(famGrantPath(next.lastRevokedUid)).data.get('revoked', false) == true;
    }

    // The one step a signed-in user may take on a code: used + 1, only in
    // the same batch that creates their own codeAccess for exactly this code.
    function famIsRedeemStep(code) {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == resource.data.used + 1
        && request.resource.data.used <= resource.data.maxUses
        && resource.data.active == true
        && request.time < resource.data.expiresAt
        && !exists(famGrantPath(request.auth.uid))
        && existsAfter(famGrantPath(request.auth.uid))
        && getAfter(famGrantPath(request.auth.uid)).data.code == code;
    }

    function famIsValidGrant(data) {
      return data.keys().hasOnly(['code', 'type', 'createdAt'])
        && data.keys().hasAll(['code', 'type', 'createdAt'])
        && famIsCodeId(data.code)
        && data.createdAt == request.time
        && exists(famCodePath(data.code))
        && famIsRedeemableCode(data, get(famCodePath(data.code)).data, getAfter(famCodePath(data.code)).data);
    }

    function famIsRedeemableCode(data, before, after) {
      return before.active == true
        && request.time < before.expiresAt
        && data.type == before.type
        && before.used < before.maxUses
        && after.used == before.used + 1;
    }

    // Revoke: superuser sets revoked + revokedAt once. If the code still
    // exists, the same batch must lower its used by 1 for this uid.
    function famIsRevoke(uid) {
      let code = resource.data.code;
      return isAccessSuperuser()
        && resource.data.get('revoked', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt'])
        && request.resource.data.revoked == true
        && request.resource.data.revokedAt == request.time
        && (
          !exists(famCodePath(code))
          || (
            getAfter(famCodePath(code)).data.used == get(famCodePath(code)).data.used - 1
            && getAfter(famCodePath(code)).data.get('lastRevokedUid', null) == uid
          )
        );
    }

    match /accessCodes/{code} {
      allow get, list: if isAccessSuperuser();
      allow create: if isAccessSuperuser()
        && famIsCodeId(code)
        && famIsValidCodeDoc()
        && request.resource.data.used == 0
        && !('lastRevokedUid' in request.resource.data);
      allow update: if famIsSuperuserEdit() || famIsRevokeStep(code) || famIsRedeemStep(code);
      allow delete: if isAccessSuperuser();
    }

    match /codeAccess/{uid} {
      allow get: if isAccessSuperuser() || isSelf(uid);
      allow list: if isAccessSuperuser();
      allow create: if isSelf(uid) && famIsValidGrant(request.resource.data);
      allow update: if famIsRevoke(uid);
      allow delete: if isAccessSuperuser();
    }
    // ===== END familiecode =====

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
