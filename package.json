{
  "name": "uculi-app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tools/verify-core-flows.mjs && node tools/verify-recipe-draft.mjs",
    "test:core": "node tools/verify-core-flows.mjs",
    "test:recipe-draft": "node tools/verify-recipe-draft.mjs",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-uculi-rules \"node --test tests/firestore-rules-familiecode.test.mjs\"",
    "test:plan": "node tools/verify-plan-check.mjs",
    "test:shopping-share": "node tools/verify-shopping-share.mjs",
    "test:cover-stickers": "node tools/verify-cover-stickers.mjs",
    "test:audit-screens": "node tools/audit-screens.mjs",
    "test:hierarchy": "node tools/verify-hierarchy.mjs",
    "test:all": "node tools/verify-core-flows.mjs && node tools/verify-plan-check.mjs && node tools/verify-shopping-share.mjs && node tools/verify-cover-stickers.mjs && node tools/verify-hierarchy.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "puppeteer-core": "^24.22.0"
  }
}
